            <title>2.13.96</title>
            <pubDate>Fri, 07 Aug 2026 00:31:38 -0700</pubDate>
            <link>https://github.com/LakshyaSingh/now-updates/releases</link>
            <sparkle:version>203</sparkle:version>
            <sparkle:shortVersionString>2.13.96</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>10.13</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[# Now 2.13.96

- Lyrics now keep time on Amazon Music instead of arriving about half a second late. Amazon reports its playback position only to the nearest whole second, always rounding down, so the correction applies to Amazon alone and leaves every other service untouched.
]]></description>
            <enclosure url="https://github.com/LakshyaSingh/now-updates/releases/download/v2.13.96/Now-2.13.96.zip" length="7347812" type="application/octet-stream" sparkle:edSignature="w4ewhyxThFIpJAsmAdoUNN6qQ6Rg2ZKmFB0QFQ+l1Njn/7+4S14BO5irffYtQlyuOsX34Gp/OcZ89UZ/T4GsBw=="/>
        </item>
